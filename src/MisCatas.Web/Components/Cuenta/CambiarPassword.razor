@page "/cuenta/cambiar-password"
@attribute [ExcludeFromInteractiveRouting]
@attribute [Authorize]
@layout LayoutVacio

<PageTitle>Cambiar contraseña · MisCatas</PageTitle>

<div class="pantalla">
    <div class="tarjeta">
        <header class="cabecera">
            <h1>Cambiar contraseña</h1>
            <p>
                @if (Obligatorio)
                {
                    <text>Debes elegir una contraseña propia antes de continuar.</text>
                }
                else
                {
                    <text>Elige una contraseña nueva.</text>
                }
            </p>
        </header>

        @if (!string.IsNullOrEmpty(Error))
        {
            <p class="error" role="alert">@Error</p>
        }

        <EditForm Model="Datos" FormName="formulario-cambiar-password" OnValidSubmit="GuardarAsync">
            <DataAnnotationsValidator />

            <label class="campo">
                <span>Contraseña actual</span>
                <InputText @bind-Value="Datos.Actual"
                           type="password"
                           autocomplete="current-password" />
                <ValidationMessage For="() => Datos.Actual" />
            </label>

            <label class="campo">
                <span>Contraseña nueva</span>
                <InputText @bind-Value="Datos.Nueva"
                           type="password"
                           autocomplete="new-password" />
                <ValidationMessage For="() => Datos.Nueva" />
            </label>

            <label class="campo">
                <span>Repite la nueva</span>
                <InputText @bind-Value="Datos.Repetida"
                           type="password"
                           autocomplete="new-password" />
                <ValidationMessage For="() => Datos.Repetida" />
            </label>

            <button type="submit" class="boton">Guardar</button>
        </EditForm>

        @if (!Obligatorio)
        {
            <a class="enlace" href="/">Volver al inicio</a>
        }
    </div>
</div>
