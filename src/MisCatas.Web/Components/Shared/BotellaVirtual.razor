@* ---------------------------------------------------------------------------
   Botella virtual: botella de vino dibujada en SVG sobre la que se compone la
   foto de la etiqueta subida por el administrador.

   La etiqueta no se pega plana: se recorta con un clipPath, se curva con un
   degradado de sombras laterales y se remata con un reflejo vertical, para
   que parezca envuelta alrededor del vidrio.

   El SVG es responsivo por viewBox, así que la misma pieza funciona en un
   móvil de 360 px CSS y en una TV de 1920 px.
   --------------------------------------------------------------------------- *@

<figure class="@ClasesFinales">
    <svg class="botella-svg"
         viewBox="0 0 120 360"
         preserveAspectRatio="xMidYMid meet"
         role="img"
         aria-label="@TextoAccesible">
        <title>@TextoAccesible</title>

        <defs>
            @* Silueta completa de la botella: se usa para recortar el vidrio. *@
            <clipPath id="@($"recorte-botella-{_id}")">
                <path d="@SiluetaBotella" />
            </clipPath>

            @* Zona de la etiqueta: rectángulo con los lados ligeramente
               abombados, igual que una etiqueta pegada en un cilindro. *@
            <clipPath id="@($"recorte-etiqueta-{_id}")">
                <path d="M 24 196
                         C 24 192, 25 190, 28 190
                         L 92 190
                         C 95 190, 96 192, 96 196
                         L 96 286
                         C 96 290, 95 292, 92 292
                         L 28 292
                         C 25 292, 24 290, 24 286
                         Z" />
            </clipPath>

            @* Vidrio: verde botella oscuro con el centro más luminoso. *@
            <linearGradient id="@($"vidrio-{_id}")" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0%" stop-color="@ColorVidrioBorde" />
                <stop offset="22%" stop-color="@ColorVidrio" />
                <stop offset="42%" stop-color="@ColorVidrioLuz" />
                <stop offset="62%" stop-color="@ColorVidrio" />
                <stop offset="100%" stop-color="@ColorVidrioBorde" />
            </linearGradient>

            @* Curvatura de la etiqueta: oscurece los extremos. *@
            <linearGradient id="@($"curva-{_id}")" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0%" stop-color="#000" stop-opacity="0.38" />
                <stop offset="14%" stop-color="#000" stop-opacity="0.12" />
                <stop offset="38%" stop-color="#fff" stop-opacity="0.10" />
                <stop offset="62%" stop-color="#fff" stop-opacity="0.04" />
                <stop offset="86%" stop-color="#000" stop-opacity="0.14" />
                <stop offset="100%" stop-color="#000" stop-opacity="0.40" />
            </linearGradient>

            @* Reflejo vertical del vidrio. *@
            <linearGradient id="@($"reflejo-{_id}")" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0%" stop-color="#fff" stop-opacity="0" />
                <stop offset="45%" stop-color="#fff" stop-opacity="0.5" />
                <stop offset="100%" stop-color="#fff" stop-opacity="0" />
            </linearGradient>

            @* Cápsula superior en burdeos con filete dorado. *@
            <linearGradient id="@($"capsula-{_id}")" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0%" stop-color="#3F0F18" />
                <stop offset="38%" stop-color="#8C2F39" />
                <stop offset="62%" stop-color="#6B1F2E" />
                <stop offset="100%" stop-color="#3F0F18" />
            </linearGradient>
        </defs>

        @* --- Vidrio --- *@
        <g clip-path="@($"url(#recorte-botella-{_id})")">
            <path d="@SiluetaBotella" fill="@($"url(#vidrio-{_id})")" />

            @* --- Etiqueta --- *@
            @if (TieneEtiqueta)
            {
                <g clip-path="@($"url(#recorte-etiqueta-{_id})")">
                    <image href="@UrlEtiqueta"
                           x="24" y="190" width="72" height="102"
                           preserveAspectRatio="xMidYMid slice" />
                    <rect x="24" y="190" width="72" height="102"
                          fill="@($"url(#curva-{_id})")" />
                </g>
            }
            else
            {
                @* Sin etiqueta: hueco crema con el número de orden o un icono. *@
                <g clip-path="@($"url(#recorte-etiqueta-{_id})")">
                    <rect x="24" y="190" width="72" height="102" fill="#F7F3EE" />
                    @if (NumeroOrden is int numero)
                    {
                        @* El <g> envolvente es necesario: Razor reserva <text> como
                           primer tag dentro de un bloque de código. *@
                        <g class="etiqueta-rotulo">
                            <text x="60" y="232" text-anchor="middle"
                                  class="etiqueta-antetitulo">VINO Nº</text>
                            <text x="60" y="272" text-anchor="middle"
                                  class="etiqueta-numero">@numero</text>
                        </g>
                    }
                    else
                    {
                        <path d="M48 222h24l-2 13a10 10 0 0 1-20 0l-2-13Z M60 250v14 M53 264h14"
                              fill="none" stroke="#8C2F39" stroke-width="2.4"
                              stroke-linecap="round" stroke-linejoin="round" />
                    }
                    <rect x="24" y="190" width="72" height="102"
                          fill="@($"url(#curva-{_id})")" />
                </g>
            }

            @* Filete dorado arriba y abajo de la etiqueta. *@
            <rect x="24" y="189" width="72" height="1.4" fill="#C9A227" opacity="0.85" />
            <rect x="24" y="291" width="72" height="1.4" fill="#C9A227" opacity="0.85" />

            @* --- Cápsula --- *@
            <rect x="46" y="8" width="28" height="44" fill="@($"url(#capsula-{_id})")" />
            <rect x="46" y="46" width="28" height="2.4" fill="#C9A227" opacity="0.9" />

            @* --- Reflejo --- *@
            <rect x="30" y="14" width="9" height="330" rx="4.5"
                  fill="@($"url(#reflejo-{_id})")" opacity="0.5" />
        </g>

        @* Contorno general, para que la botella se despegue del fondo. *@
        <path d="@SiluetaBotella" fill="none" stroke="#17050A" stroke-opacity="0.45" stroke-width="1.6" />

        @* --- Sello de nota sobre el hombro ---
           Va FUERA del recorte del vidrio: así puede sobresalir un poco del
           perfil de la botella, como una pegatina de puntuación de tienda. *@
        @if (TieneSello)
        {
            <g class="botella-sello">
                <circle cx="92" cy="128" r="26" fill="#FBF6EE" stroke="#6B1F2E" stroke-width="3" />
                <circle cx="92" cy="128" r="21" fill="none" stroke="#C9A227" stroke-width="1.4" />
                <text x="92" y="137" text-anchor="middle" class="botella-sello-nota">@Nota</text>
            </g>
        }

        @* --- Medallón de puesto colgado del cuello --- *@
        @if (TieneMedallon)
        {
            <g class="botella-medallon">
                <path d="M 52 30 C 44 46, 34 54, 30 62" fill="none"
                      stroke="@ColoresMedallon.Borde" stroke-width="2.6" stroke-linecap="round" />
                <circle cx="28" cy="74" r="19"
                        fill="@ColoresMedallon.Fondo" stroke="@ColoresMedallon.Borde" stroke-width="3" />
                <text x="28" y="82" text-anchor="middle"
                      class="botella-medallon-numero" fill="@ColoresMedallon.Texto">@Puesto</text>
            </g>
        }
    </svg>

    @if (!string.IsNullOrWhiteSpace(Pie))
    {
        <figcaption class="botella-pie">@Pie</figcaption>
    }
</figure>
