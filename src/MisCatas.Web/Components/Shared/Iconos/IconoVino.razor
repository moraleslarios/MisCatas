@* ---------------------------------------------------------------------------
   Icono SVG inline. Todos los trazos son propios y se dibujan sobre un lienzo
   de 24x24 heredando el color del texto (currentColor), así que el icono se
   tiñe solo con las utilidades de color de Tailwind.

   Accesibilidad: si se pasa Etiqueta, el SVG se anuncia como imagen con ese
   texto. Si no, se marca aria-hidden porque es puramente decorativo y el
   significado lo aporta el texto visible de al lado.
   --------------------------------------------------------------------------- *@

<svg class="@ClasesFinales"
     viewBox="0 0 24 24"
     fill="none"
     stroke="currentColor"
     stroke-width="@Grosor.ToString(System.Globalization.CultureInfo.InvariantCulture)"
     stroke-linecap="round"
     stroke-linejoin="round"
     focusable="false"
     aria-hidden="@(EsDecorativo ? "true" : null)"
     role="@(EsDecorativo ? null : "img")"
     aria-label="@(EsDecorativo ? null : Etiqueta)">
    @if (!EsDecorativo)
    {
        <title>@Etiqueta</title>
    }
    @switch (Nombre)
    {
        case Icono.Copa:
            <path d="M7 3h10l-.8 5.3a4.3 4.3 0 0 1-8.4 0L7 3Z" />
            <path d="M12 14.6V20" />
            <path d="M8.6 20h6.8" />
