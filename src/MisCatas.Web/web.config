<?xml version="1.0" encoding="utf-8"?>
<!--
  Configuración para cuando la web la sirve un IIS local.

  Este fichero NO se usa al arrancar con Arrancar.cmd (ahí la aplicación lleva
  su propio servidor). Solo lo lee IIS, y al publicar con "dotnet publish" se
  completa automáticamente con la ruta del ejecutable.

  Lo que se ajusta a mano aquí:
    - maxAllowedContentLength: 15 MB, para que entren las fotos de las
      botellas. IIS corta por defecto en 30 MB pero su filtro de peticiones
      rechaza antes, así que se iguala al límite de la aplicación.
    - requestTimeout: 20 minutos. Las conexiones en vivo se mantienen abiertas
      mientras una cata está en curso.

  OJO: aquí NO se puede poner <webSocket>. IIS mantiene esa sección cerrada
  con llave a nivel de servidor, y cualquier web que intente tocarla se cae
  con el error 500.19 ("esta sección de configuración no puede utilizarse en
  esta ruta"). Los WebSocket, que son los que hacen que los votos aparezcan
  al instante en el escaparate, se activan desde el propio servidor: lo hace
  el paso 6 de tools\desplegar-iis.ps1.
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
    </handlers>

    <aspNetCore processPath="dotnet"
                arguments=".\MisCatas.Web.dll"
                stdoutLogEnabled="false"
                stdoutLogFile=".\logs\stdout"
                hostingModel="inprocess"
                requestTimeout="00:20:00">
      <environmentVariables>
        <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />

        <!--
          Dirección con la que se construyen los QR y los enlaces de WhatsApp.

          Es la IP de este equipo con el puerto 5080, y no el nombre
          miscatas.es, porque ese nombre SOLO existe dentro de este ordenador:
          desde un móvil o desde el televisor no lleva a ninguna parte, así que
          el QR no se podía abrir. Con la IP sí.

          Va con https porque IIS sirve ese puerto cifrado, con el mismo
          certificado de la casa (que incluye la IP entre sus nombres). La
          primera vez el móvil avisará de que el certificado no lo ha firmado
          ninguna autoridad conocida: hay que entrar en "Avanzado" y continuar.

          Va aquí (y no en appsettings.Production.json) porque el arranque de
          pruebas en modo producción (tools\arrancar-produccion.ps1) también usa
          ese fichero y allí la web NO responde en esta dirección.

          No hace falta mantenerla a mano: tools\desplegar-iis.ps1 mira la IP
          real del equipo y la reescribe aquí en cada despliegue. Este valor es
          solo el de partida.
        -->
        <environmentVariable name="Sitio__UrlPublica" value="https://192.168.2.139:5080" />

        <!--
          Confirma a la aplicación que la sirve IIS, por si fallara la
          detección automática. Así no intenta abrir los puertos 5443/5080 por
          su cuenta (de abrirlos se encarga IIS en la configuración del sitio).
        -->
        <environmentVariable name="Hospedaje__Iis" value="true" />
      </environmentVariables>
    </aspNetCore>

    <security>
      <requestFiltering>
        <!-- 15 MB en bytes: igual que el límite de subida de la aplicación. -->
        <requestLimits maxAllowedContentLength="15728640" />
      </requestFiltering>
    </security>

    <httpProtocol>
      <customHeaders>
        <!-- No anunciar la versión del servidor. -->
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
