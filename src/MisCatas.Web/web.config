<?xml version="1.0" encoding="utf-8"?>
<!--
  Configuración para cuando la web la sirve un IIS local.

  Este fichero NO se usa al arrancar con Arrancar.cmd (ahí la aplicación lleva
  su propio servidor). Solo lo lee IIS, y al publicar con "dotnet publish" se
  completa automáticamente con la ruta del ejecutable.

  Lo que se ajusta a mano aquí:
    - webSocket: imprescindible. La cata en vivo (votos que aparecen al
      instante en el escaparate) viaja por WebSocket. Sin esto IIS lo bloquea
      y la pantalla se queda congelada.
    - maxAllowedContentLength: 15 MB, para que entren las fotos de las
      botellas. IIS corta por defecto en 30 MB pero su filtro de peticiones
      rechaza antes, así que se iguala al límite de la aplicación.
    - requestTimeout: 20 minutos. Las conexiones en vivo se mantienen abiertas
      mientras una cata está en curso.
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
    </handlers>

    <aspNetCore processPath="dotnet"
                arguments=".\MisCatas.Web.dll"
                stdoutLogEnabled="false"
                stdoutLogFile=".\logs\stdout"
                hostingModel="inprocess"
                requestTimeout="00:20:00">
      <environmentVariables>
        <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />

        <!--
          Dirección con la que se construyen los QR y los enlaces de WhatsApp.
          Va aquí (y no en appsettings.Production.json) porque el arranque de
          pruebas en modo producción (tools\arrancar-produccion.ps1) también usa
          ese fichero y allí la web NO responde en miscatas.es.
        -->
        <environmentVariable name="Sitio__UrlPublica" value="https://miscatas.es" />

        <!--
          Confirma a la aplicación que la sirve IIS, por si fallara la
          detección automática. Así no intenta abrir los puertos 5443/5080.
        -->
        <environmentVariable name="Hospedaje__Iis" value="true" />
      </environmentVariables>
    </aspNetCore>

    <webSocket enabled="true" pingInterval="00:00:10" />

    <security>
      <requestFiltering>
        <!-- 15 MB en bytes: igual que el límite de subida de la aplicación. -->
        <requestLimits maxAllowedContentLength="15728640" />
      </requestFiltering>
    </security>

    <httpProtocol>
      <customHeaders>
        <!-- No anunciar la versión del servidor. -->
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
